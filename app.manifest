<?xml version="1.0" encoding="utf-8"?>

<assembly
    manifestVersion="1.0"
    xmlns="urn:schemas-microsoft-com:asm.v1">

    <!--
        Манифест используется только в Windows.
        Не удалять: он необходим для корректной работы
        прозрачности окон и встроенных элементов управления Avalonia.

        Подробнее:
        https://learn.microsoft.com/en-us/windows/win32/sbscs/application-manifests
    -->

    <assemblyIdentity
        version="1.0.0.0"
        name="Libris.Desktop" />

    <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
        <application>

            <!--
                Указывает версии Windows, с которыми приложение
                совместимо и для которых оно было протестировано.
            -->

            <!-- Windows 10 -->
            <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />

        </application>
    </compatibility>

</assembly>