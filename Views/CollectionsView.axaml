<!--  Views/CollectionsView.axaml  -->
<UserControl
    x:Class="Libris.Views.CollectionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Libris.Controls"
    xmlns:converters="using:Libris.Converters"
    xmlns:models="using:Libris.Models"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="using:Libris.ViewModels"
    x:DataType="vm:CollectionsViewModel">

    <!--  Ресурсы представления  -->
    <UserControl.Resources>
        <!--  Конвертер для отображения обложек книг  -->
        <converters:BookCoverConverter x:Key="BookCoverConverter" />
    </UserControl.Resources>

    <Grid
        Margin="28,24,28,32"
        RowDefinitions="Auto,*"
        RowSpacing="24">

        <!--  Заголовок страницы  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="20">

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="Collections" />

                <TextBlock
                    FontSize="14"
                    Opacity="0.55"
                    Text="Organize your books into personal collections." />
            </StackPanel>

            <!--  Создание новой коллекции  -->
            <Grid
                Grid.Column="1"
                VerticalAlignment="Center"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">

                <TextBox
                    Grid.Column="0"
                    Width="210"
                    Padding="12,9"
                    CornerRadius="9"
                    PlaceholderText="New collection..."
                    Text="{Binding NewCollectionName, Mode=TwoWay}" />

                <Button
                    Grid.Column="1"
                    Padding="16,9"
                    Classes="Flat Rounded"
                    Command="{Binding CreateCollectionCommand}"
                    Content="Create" />
            </Grid>
        </Grid>

        <!--  Основное содержимое страницы  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="220,*"
            ColumnSpacing="22">

            <!--  Состояние при отсутствии коллекций  -->
            <StackPanel
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Spacing="8">

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="25"
                    FontWeight="SemiBold"
                    Text="No collections yet" />

                <TextBlock
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    Opacity="0.55"
                    Text="Create your first collection to organize your books."
                    TextAlignment="Center" />
            </StackPanel>

            <!--  Боковая панель со списком коллекций  -->
            <suki:GlassCard
                Grid.Column="0"
                Padding="10"
                IsAnimated="True"
                IsVisible="{Binding !IsEmpty}">

                <Grid RowDefinitions="Auto,*">

                    <!--  Заголовок списка коллекций  -->
                    <Grid Margin="10,6,10,12" ColumnDefinitions="*,Auto">

                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Collections" />

                        <!--  Количество коллекций  -->
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Opacity="0.45"
                            Text="{Binding Collections.Count}" />
                    </Grid>

                    <!--  Список коллекций  -->
                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Collections}"
                        SelectedItem="{Binding SelectedCollection, Mode=TwoWay}">

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:BookCollection">

                                <!--  Элемент списка коллекций  -->
                                <Border
                                    Margin="0,2"
                                    Padding="12,10"
                                    CornerRadius="8">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />

                                        <!--  Количество книг в коллекции  -->
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            Opacity="0.4"
                                            Text="{Binding BookIds.Count}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </suki:GlassCard>

            <!--  Содержимое выбранной коллекции  -->
            <Grid
                Grid.Column="1"
                IsVisible="{Binding !IsEmpty}"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="18">

                <!--  Заголовок выбранной коллекции  -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="16">

                    <!--  Название коллекции  -->
                    <StackPanel
                        Grid.Column="0"
                        IsVisible="{Binding !IsRenaming}"
                        Spacing="3">

                        <TextBlock
                            FontSize="25"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedCollection.Name}" />

                        <!--  Количество книг в выбранной коллекции  -->
                        <TextBlock
                            FontSize="13"
                            Opacity="0.5"
                            Text="{Binding CollectionBooks.Count, StringFormat='{}{0} books'}" />
                    </StackPanel>

                    <!--  Редактор названия коллекции  -->
                    <Grid
                        Grid.Column="0"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="7"
                        IsVisible="{Binding IsRenaming}">

                        <TextBox
                            Grid.Column="0"
                            Padding="11,8"
                            CornerRadius="8"
                            Text="{Binding RenameCollectionName, Mode=TwoWay}" />

                        <!--  Сохранить новое название  -->
                        <Button
                            Grid.Column="1"
                            Padding="13,8"
                            Classes="Flat Rounded"
                            Command="{Binding RenameCollectionCommand}"
                            Content="Save" />

                        <!--  Отменить переименование  -->
                        <Button
                            Grid.Column="2"
                            Padding="13,8"
                            Classes="Flat Rounded"
                            Command="{Binding CancelRenameCommand}"
                            Content="Cancel" />
                    </Grid>

                    <!--  Действия над коллекцией  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !IsRenaming}"
                        Orientation="Horizontal"
                        Spacing="7">

                        <!--  Открыть/закрыть панель добавления книг  -->
                        <Button
                            Padding="14,8"
                            Classes="Outlined Rounded"
                            Command="{Binding ToggleAddBooksCommand}"
                            Content="{Binding AddBooksButtonText}" />

                        <!--  Переименовать коллекцию  -->
                        <Button
                            Padding="14,8"
                            Classes="Flat Rounded"
                            Command="{Binding StartRenameCommand}"
                            Content="Rename" />

                        <!--  Удалить коллекцию  -->
                        <Button
                            Padding="14,8"
                            Classes="Flat Rounded"
                            Command="{Binding DeleteCollectionCommand}"
                            Content="Delete" />
                    </StackPanel>
                </Grid>

                <!--  Панель добавления книг в коллекцию  -->
                <suki:GlassCard
                    Grid.Row="1"
                    Padding="14"
                    IsAnimated="True"
                    IsVisible="{Binding IsAddBooksOpen}">

                    <Grid RowDefinitions="Auto,*" RowSpacing="12">

                        <!--  Поиск книг  -->
                        <TextBox
                            Grid.Row="0"
                            Padding="11,8"
                            CornerRadius="8"
                            PlaceholderText="Search by title or author..."
                            Text="{Binding BookSearchQuery, Mode=TwoWay}" />

                        <!--  Доступные для добавления книги  -->
                        <Grid Grid.Row="1">

                            <ScrollViewer
                                MaxHeight="230"
                                HorizontalScrollBarVisibility="Disabled"
                                IsVisible="{Binding HasAvailableBooks}"
                                VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding FilteredAvailableBooks}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <!--  Книга, доступная для добавления  -->
                                            <Border
                                                Margin="0,2"
                                                Padding="9"
                                                CornerRadius="8">

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                                    <!--  Информация о книге  -->
                                                    <StackPanel Grid.Column="0" Spacing="2">

                                                        <TextBlock
                                                            FontSize="13.5"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <TextBlock
                                                            FontSize="12"
                                                            Opacity="0.5"
                                                            Text="{Binding Author}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!--  Добавить книгу  -->
                                                    <Button
                                                        Grid.Column="1"
                                                        Padding="13,7"
                                                        Classes="Flat Rounded"
                                                        Command="{Binding $parent[ItemsControl].DataContext.AddBookCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="Add" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!--  Состояние при отсутствии доступных книг  -->
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasAvailableBooks}"
                                Spacing="4">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="No books to add" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.5"
                                    Text="All books from your library are already here." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </suki:GlassCard>

                <!--  Книги выбранной коллекции  -->
                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <Grid Margin="2">

                        <!--  Сетка книг  -->
                        <ItemsControl IsVisible="{Binding HasCollectionBooks}" ItemsSource="{Binding CollectionBooks}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>

                                    <!--  Адаптивная сетка карточек  -->
                                    <controls:ResponsiveWrapPanel
                                        HorizontalSpacing="18"
                                        ItemHeight="326"
                                        ItemWidth="184"
                                        VerticalSpacing="20" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <!--  Карточка книги  -->
                                    <suki:GlassCard
                                        Width="184"
                                        Height="326"
                                        Padding="0"
                                        IsAnimated="True"
                                        IsInteractive="True">

                                        <Grid RowDefinitions="218,*">

                                            <!--  Обложка книги  -->
                                            <Button
                                                Grid.Row="0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding $parent[ItemsControl].DataContext.SelectBookCommand}"
                                                CommandParameter="{Binding}">

                                                <Border ClipToBounds="True" CornerRadius="10,10,0,0">

                                                    <Image Source="{Binding CoverPath, Converter={StaticResource BookCoverConverter}}" Stretch="UniformToFill" />
                                                </Border>
                                            </Button>

                                            <!--  Информация и действия  -->
                                            <Grid
                                                Grid.Row="1"
                                                Margin="11,9,11,10"
                                                RowDefinitions="*,Auto"
                                                RowSpacing="6">

                                                <!--  Название и автор  -->
                                                <Button
                                                    Grid.Row="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Left"
                                                    VerticalContentAlignment="Top"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding $parent[ItemsControl].DataContext.SelectBookCommand}"
                                                    CommandParameter="{Binding}">

                                                    <StackPanel Spacing="3">

                                                        <TextBlock
                                                            FontSize="13.5"
                                                            FontWeight="SemiBold"
                                                            MaxLines="2"
                                                            Text="{Binding Title}"
                                                            TextWrapping="Wrap" />

                                                        <TextBlock
                                                            FontSize="12"
                                                            Opacity="0.5"
                                                            Text="{Binding Author}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>

                                                <!--  Удалить книгу из коллекции  -->
                                                <Button
                                                    Grid.Row="1"
                                                    Padding="7,5"
                                                    Classes="Flat Rounded"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveBookCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="Remove" />
                                            </Grid>
                                        </Grid>
                                    </suki:GlassCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Состояние пустой коллекции  -->
                        <StackPanel
                            Margin="0,50,0,0"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding !HasCollectionBooks}"
                            Spacing="7">

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="This collection is empty" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Opacity="0.5"
                                Text="Add books from your library to get started." />

                            <!--  Открыть панель добавления книг  -->
                            <Button
                                Margin="0,6,0,0"
                                Padding="15,8"
                                HorizontalAlignment="Center"
                                Classes="Flat Rounded"
                                Command="{Binding ToggleAddBooksCommand}"
                                Content="Add books" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
