<!--  Views/CollectionsView.axaml  -->
<!--  Views/CollectionsView.axaml  -->

<UserControl
    x:Class="Libris.Views.CollectionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Libris.Controls"
    xmlns:models="using:Libris.Models"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="using:Libris.ViewModels"
    x:DataType="vm:CollectionsViewModel">

    <Grid
        Margin="28,24,28,32"
        RowDefinitions="Auto,*"
        RowSpacing="24">

        <!--  Заголовок  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="20">

            <StackPanel Spacing="4">

                <TextBlock
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="Collections" />

                <TextBlock
                    FontSize="14"
                    Opacity="0.55"
                    Text="Organize your books into personal collections." />

            </StackPanel>

            <!--  Создание коллекции  -->
            <Grid
                Grid.Column="1"
                VerticalAlignment="Center"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">

                <TextBox
                    Grid.Column="0"
                    Width="210"
                    Padding="12,9"
                    CornerRadius="9"
                    PlaceholderText="New collection..."
                    Text="{Binding NewCollectionName, Mode=TwoWay}" />

                <Button
                    Grid.Column="1"
                    Padding="16,9"
                    Classes="Flat Rounded"
                    Command="{Binding CreateCollectionCommand}"
                    Content="Create" />

            </Grid>

        </Grid>

        <!--  Основное содержимое  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="220,*"
            ColumnSpacing="22">

            <!--  Нет коллекций  -->
            <StackPanel
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Spacing="8">

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="25"
                    FontWeight="SemiBold"
                    Text="No collections yet" />

                <TextBlock
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    Opacity="0.55"
                    Text="Create your first collection to organize your books."
                    TextAlignment="Center" />

            </StackPanel>

            <!--  Список коллекций  -->
            <suki:GlassCard
                Grid.Column="0"
                Padding="10"
                IsAnimated="True"
                IsVisible="{Binding !IsEmpty}">

                <Grid RowDefinitions="Auto,*">

                    <Grid Margin="10,6,10,12" ColumnDefinitions="*,Auto">

                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Collections" />

                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Opacity="0.45"
                            Text="{Binding Collections.Count}" />

                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Collections}"
                        SelectedItem="{Binding SelectedCollection, Mode=TwoWay}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Margin="0,2"
                                    Padding="12,10"
                                    CornerRadius="8">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            Opacity="0.4"
                                            Text="{Binding BookIds.Count}" />

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </suki:GlassCard>

            <!--  Выбранная коллекция  -->
            <Grid
                Grid.Column="1"
                IsVisible="{Binding !IsEmpty}"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="18">

                <!--  Заголовок коллекции  -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="16">

                    <!--  Название  -->
                    <StackPanel
                        Grid.Column="0"
                        IsVisible="{Binding !IsRenaming}"
                        Spacing="3">

                        <TextBlock
                            FontSize="25"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedCollection.Name}" />

                        <TextBlock
                            FontSize="13"
                            Opacity="0.5"
                            Text="{Binding CollectionBooks.Count, StringFormat='{}{0} books'}" />

                    </StackPanel>

                    <!--  Переименование  -->
                    <Grid
                        Grid.Column="0"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="7"
                        IsVisible="{Binding IsRenaming}">

                        <TextBox
                            Grid.Column="0"
                            Padding="11,8"
                            CornerRadius="8"
                            Text="{Binding RenameCollectionName, Mode=TwoWay}" />

                        <Button
                            Grid.Column="1"
                            Padding="13,8"
                            Classes="Flat Rounded"
                            Command="{Binding RenameCollectionCommand}"
                            Content="Save" />

                        <Button
                            Grid.Column="2"
                            Padding="13,8"
                            Classes="Flat Rounded"
                            Command="{Binding CancelRenameCommand}"
                            Content="Cancel" />

                    </Grid>

                    <!--  Действия  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !IsRenaming}"
                        Orientation="Horizontal"
                        Spacing="7">

                        <Button
                            Padding="14,8"
                            Classes="Outlined Rounded"
                            Command="{Binding ToggleAddBooksCommand}"
                            Content="{Binding AddBooksButtonText}" />

                        <Button
                            Padding="14,8"
                            Classes="Flat Rounded"
                            Command="{Binding StartRenameCommand}"
                            Content="Rename" />

                        <Button
                            Padding="14,8"
                            Classes="Flat Rounded"
                            Command="{Binding DeleteCollectionCommand}"
                            Content="Delete" />

                    </StackPanel>

                </Grid>

                <!--  Панель добавления книг  -->
                <suki:GlassCard
                    Grid.Row="1"
                    Padding="14"
                    IsAnimated="True"
                    IsVisible="{Binding IsAddBooksOpen}">

                    <Grid RowDefinitions="Auto,*" RowSpacing="12">

                        <TextBox
                            Grid.Row="0"
                            Padding="11,8"
                            CornerRadius="8"
                            PlaceholderText="Search by title or author..."
                            Text="{Binding BookSearchQuery, Mode=TwoWay}" />

                        <Grid Grid.Row="1">

                            <ScrollViewer
                                MaxHeight="230"
                                HorizontalScrollBarVisibility="Disabled"
                                IsVisible="{Binding HasAvailableBooks}"
                                VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding FilteredAvailableBooks}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Book">

                                            <Border
                                                Margin="0,2"
                                                Padding="9"
                                                CornerRadius="8">

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                                    <StackPanel Grid.Column="0" Spacing="2">

                                                        <TextBlock
                                                            FontSize="13.5"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <TextBlock
                                                            FontSize="12"
                                                            Opacity="0.5"
                                                            Text="{Binding Author}"
                                                            TextTrimming="CharacterEllipsis" />

                                                    </StackPanel>

                                                    <Button
                                                        Grid.Column="1"
                                                        Padding="13,7"
                                                        Classes="Flat Rounded"
                                                        Command="{Binding $parent[ItemsControl].DataContext.AddBookCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="Add" />

                                                </Grid>

                                            </Border>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasAvailableBooks}"
                                Spacing="4">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="No books to add" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.5"
                                    Text="All books from your library are already here." />

                            </StackPanel>

                        </Grid>

                    </Grid>

                </suki:GlassCard>

                <!--  Книги коллекции  -->
                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <Grid Margin="2">

                        <ItemsControl IsVisible="{Binding HasCollectionBooks}" ItemsSource="{Binding CollectionBooks}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>

                                    <controls:ResponsiveWrapPanel
                                        HorizontalSpacing="18"
                                        ItemHeight="326"
                                        ItemWidth="184"
                                        VerticalSpacing="20" />

                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Book">

                                    <Grid Width="184">

                                        <controls:BookCard
                                            Width="184"
                                            Height="326"
                                            OpenBookRequested="BookCard_OpenBookRequested" />

                                        <!--  Удаление из коллекции  -->
                                        <Button
                                            Margin="0,0,8,8"
                                            Padding="7,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Classes="Flat Rounded"
                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveBookCommand}"
                                            CommandParameter="{Binding}"
                                            Content="Remove" />

                                    </Grid>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!--  Пустая коллекция  -->
                        <StackPanel
                            Margin="0,50,0,0"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding !HasCollectionBooks}"
                            Spacing="7">

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="This collection is empty" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Opacity="0.5"
                                Text="Add books from your library to get started." />

                            <Button
                                Margin="0,6,0,0"
                                Padding="15,8"
                                HorizontalAlignment="Center"
                                Classes="Flat Rounded"
                                Command="{Binding ToggleAddBooksCommand}"
                                Content="Add books" />

                        </StackPanel>

                    </Grid>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</UserControl>
