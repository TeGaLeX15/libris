<!--  Views/LibraryView.axaml  -->
<UserControl
    x:Class="Libris.Views.LibraryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Libris.Controls"
    xmlns:converters="using:Libris.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="using:Libris.ViewModels"
    x:DataType="vm:LibraryViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BookCoverConverter x:Key="BookCoverConverter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <Grid
                Margin="28,24,28,32"
                RowDefinitions="Auto,*">

                <!-- Header -->
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,28"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="12">

                    <!-- Title -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="5">

                        <TextBlock
                            FontSize="32"
                            FontWeight="SemiBold"
                            Text="Library" />

                        <TextBlock
                            FontSize="14"
                            Opacity="0.6"
                            Text="Your books in one place." />

                    </StackPanel>

                    <!-- Search -->
                    <Border
                        Grid.Column="1"
                        MinWidth="220"
                        MaxWidth="460"
                        Padding="14,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="#0DFFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10">

                        <TextBox
                            Padding="4,6"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            PlaceholderText="Search your library..."
                            Text="{Binding SearchQuery, Mode=TwoWay}" />

                    </Border>

                    <!-- Sort -->
                    <ComboBox
                        Grid.Column="2"
                        Width="145"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />

                    <!-- Add books -->
                    <Button
                        Grid.Column="3"
                        Padding="20,10"
                        VerticalAlignment="Center"
                        Click="AddBooks_Click"
                        Content="Add books" />

                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1">

                    <!-- Empty library -->
                    <StackPanel
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsEmpty}"
                        Spacing="10">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="Your library is empty" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Text="Add your first books to start reading."
                            TextAlignment="Center" />

                        <Button
                            Margin="0,14,0,0"
                            Padding="24,12"
                            HorizontalAlignment="Center"
                            Click="AddBooks_Click"
                            Content="Add books" />

                    </StackPanel>

                    <!-- Search returned nothing -->
                    <StackPanel
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsSearchEmpty}"
                        Spacing="10">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="No books found" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Text="Try a different title or author."
                            TextAlignment="Center" />

                    </StackPanel>

                    <!-- Books -->
                    <ItemsControl
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding !IsEmpty}"
                        ItemsSource="{Binding FilteredBooks}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>

                                <controls:ResponsiveWrapPanel
                                    HorizontalAlignment="Stretch"
                                    HorizontalSpacing="18"
                                    ItemHeight="324"
                                    ItemWidth="184"
                                    VerticalSpacing="22" />

                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <suki:GlassCard
                                    Width="184"
                                    Height="324"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    IsAnimated="True"
                                    IsInteractive="True">

                                    <Grid RowDefinitions="226,*">

                                        <!-- Cover -->
                                        <Border
                                            Grid.Row="0"
                                            Height="226"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            ClipToBounds="True"
                                            CornerRadius="10,10,0,0">

                                            <Image
                                                Source="{Binding CoverPath, Converter={StaticResource BookCoverConverter}}"
                                                Stretch="UniformToFill" />

                                        </Border>

                                        <!-- Information -->
                                        <Grid
                                            Grid.Row="1"
                                            Margin="12,10,12,11"
                                            RowDefinitions="Auto,Auto,*">

                                            <!-- Title -->
                                            <TextBlock
                                                Grid.Row="0"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                LineHeight="19"
                                                MaxLines="2"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />

                                            <!-- Author -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,4,0,0"
                                                FontSize="12.5"
                                                Opacity="0.55"
                                                Text="{Binding Author}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />

                                        </Grid>

                                    </Grid>

                                </suki:GlassCard>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>

            </Grid>

        </ScrollViewer>
    </Grid>

</UserControl>
