<!--  Views/LibraryView.axaml  -->
<UserControl
    x:Class="Libris.Views.LibraryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Libris.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="using:Libris.ViewModels"
    x:DataType="vm:LibraryViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BookCoverConverter x:Key="BookCoverConverter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

            <Grid Margin="28,24,28,32" RowDefinitions="Auto,*">

                <!--  Header  -->
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,28"
                    VerticalAlignment="Top"
                    ColumnDefinitions="*,Auto">

                    <StackPanel
                        Grid.Column="0"
                        Margin="0,0,24,0"
                        Spacing="5">

                        <TextBlock
                            FontSize="32"
                            FontWeight="SemiBold"
                            Text="Library" />

                        <TextBlock
                            FontSize="14"
                            Opacity="0.6"
                            Text="Your books in one place." />

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Padding="20,10"
                        VerticalAlignment="Center"
                        Click="AddBooks_Click"
                        Content="Add books" />

                </Grid>

                <!--  Content  -->
                <Grid Grid.Row="1">

                    <!--  Empty state  -->
                    <StackPanel
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsEmpty}"
                        Spacing="10">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="Your library is empty" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Text="Add your first books to start reading."
                            TextAlignment="Center" />

                        <Button
                            Margin="0,14,0,0"
                            Padding="24,12"
                            HorizontalAlignment="Center"
                            Click="AddBooks_Click"
                            Content="Add books" />

                    </StackPanel>

                    <!--  Books  -->
                    <ItemsControl IsVisible="{Binding !IsEmpty}" ItemsSource="{Binding Books}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel
                                    ItemHeight="304"
                                    ItemWidth="190"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <suki:GlassCard
                                    Width="174"
                                    Margin="0,0,16,20"
                                    Padding="10"
                                    IsAnimated="True"
                                    IsInteractive="True">

                                    <StackPanel Spacing="9">

                                        <!--  Cover  -->
                                        <Border
                                            Width="154"
                                            Height="214"
                                            ClipToBounds="True"
                                            CornerRadius="8">

                                            <Image Source="{Binding CoverPath, Converter={StaticResource BookCoverConverter}}" Stretch="UniformToFill" />

                                        </Border>

                                        <!--  Title  -->
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            MaxLines="2"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />

                                        <!--  Author  -->
                                        <TextBlock
                                            FontSize="13"
                                            Opacity="0.6"
                                            Text="{Binding Author}"
                                            TextTrimming="CharacterEllipsis" />

                                    </StackPanel>

                                </suki:GlassCard>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>

            </Grid>

        </ScrollViewer>
    </Grid>

</UserControl>
