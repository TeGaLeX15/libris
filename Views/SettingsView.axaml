<!--  Views/SettingsView.axaml  -->
<UserControl
    x:Class="Libris.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="using:Libris.ViewModels"
    x:DataType="vm:SettingsViewModel">

    <Grid Margin="28,24,28,32">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                HorizontalAlignment="Stretch"
                Spacing="28">

                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Settings" />

                    <TextBlock
                        Opacity="0.6"
                        Text="Customize your Libris experience." />
                </StackPanel>

                <!-- Appearance -->
                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Appearance" />

                    <suki:GlassCard
                        Padding="24"
                        IsAnimated="True">

                        <StackPanel Spacing="20">

                            <!-- Theme -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Theme" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="Choose how Libris should look." />
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="180"
                                    ItemsSource="{Binding AvailableThemes}"
                                    SelectedItem="{Binding Theme}" />
                            </Grid>

                            <!-- Accent Color -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Accent Color" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="Choose the application's accent color." />
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="180"
                                    ItemsSource="{Binding AvailableAccentColors}"
                                    SelectedItem="{Binding AccentColor}" />
                            </Grid>

                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>

                <!-- Reading -->
                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Reading" />

                    <suki:GlassCard
                        Padding="24"
                        IsAnimated="True">

                        <StackPanel Spacing="20">

                            <!-- Default Font -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Default Font" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="Font used when opening a book." />
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="180"
                                    ItemsSource="{Binding AvailableFonts}"
                                    SelectedItem="{Binding DefaultFont}" />
                            </Grid>

                            <!-- Font Size -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Font Size" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="Default reading text size." />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    Increment="1"
                                    Maximum="40"
                                    Minimum="10"
                                    Value="{Binding FontSize}" />
                            </Grid>

                            <!-- Line Spacing -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Line Spacing" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="Space between lines of text." />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    Increment="0.1"
                                    Maximum="3"
                                    Minimum="1"
                                    Value="{Binding LineSpacing}" />
                            </Grid>

                            <!-- Reading Width -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Reading Width" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="Maximum width of the reading area." />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    Increment="20"
                                    Maximum="1200"
                                    Minimum="400"
                                    Value="{Binding ReadingWidth}" />
                            </Grid>

                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>

                <!-- Library -->
                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Library" />

                    <suki:GlassCard
                        Padding="24"
                        IsAnimated="True">

                        <StackPanel Spacing="20">

                            <!-- Default Sorting -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Default Sorting" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="How books are sorted by default." />
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="180"
                                    ItemsSource="{Binding AvailableSortingOptions}"
                                    SelectedItem="{Binding DefaultSorting}" />
                            </Grid>

                            <!-- Show Progress -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Show Progress" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="Display reading progress in the library." />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding ShowProgress}" />
                            </Grid>

                            <!-- Cover Size -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="32">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Cover Size" />

                                    <TextBlock
                                        Opacity="0.6"
                                        Text="Default size of book covers." />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    Increment="10"
                                    Maximum="300"
                                    Minimum="80"
                                    Value="{Binding CoverSize}" />
                            </Grid>

                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
