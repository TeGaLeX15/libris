<!--  Views/ReaderView.axaml  -->
<UserControl
    x:Class="Libris.Views.ReaderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Libris.ViewModels"
    xmlns:web="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
    x:DataType="vm:ReaderViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Верхняя панель -->
        <Border
            x:Name="TopBar"
            Grid.Row="0"
            Padding="22,14">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                <!-- Назад -->
                <Button
                    Grid.Column="0"
                    Padding="13,8"
                    Classes="Flat Rounded"
                    Command="{Binding CloseCommand}"
                    Content="←  Library" />

                <!-- Информация о книге -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Spacing="2">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Title}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Opacity="0.5"
                        Text="{Binding Author}" />

                </StackPanel>

                <!-- Настройки -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6">

                    <Button
                        Width="38"
                        Height="38"
                        Padding="0"
                        Classes="Flat Rounded"
                        Content="Aa" />

                    <Button
                        Width="38"
                        Height="38"
                        Padding="0"
                        Classes="Flat Rounded"
                        Content="⋮" />

                </StackPanel>

            </Grid>

        </Border>

        <!-- Область чтения -->
        <Border
            x:Name="ReaderArea"
            Grid.Row="1">

            <web:NativeWebView
                x:Name="ReaderWebView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                NavigationCompleted="ReaderWebView_OnNavigationCompleted" />

        </Border>

        <!-- Нижняя панель -->
        <Border
            x:Name="BottomBar"
            Grid.Row="2"
            Padding="22,12">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">

                <Button
                    Grid.Column="0"
                    Padding="12,7"
                    Classes="Flat Rounded"
                    Command="{Binding PreviousPageCommand}"
                    Content="Previous"
                    IsEnabled="{Binding CanGoPrevious}" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="5">

                    <ProgressBar
                        Height="4"
                        Maximum="1"
                        Minimum="0"
                        Value="{Binding Progress}" />

                    <Grid ColumnDefinitions="*,Auto">

                        <TextBlock
                            FontSize="11"
                            Opacity="0.45"
                            Text="{Binding CurrentChapterTitle}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="1"
                            FontSize="11"
                            Opacity="0.45"
                            Text="{Binding ProgressText}" />

                    </Grid>

                </StackPanel>

                <Button
                    Grid.Column="2"
                    Padding="12,7"
                    Classes="Flat Rounded"
                    Command="{Binding NextPageCommand}"
                    Content="Next"
                    IsEnabled="{Binding CanGoNext}" />

            </Grid>

        </Border>

    </Grid>

</UserControl>