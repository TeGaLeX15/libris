<!--  Views/SettingsView.axaml  -->
<UserControl
    x:Class="Libris.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="using:Libris.ViewModels"
    x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <!--  Общий стиль описания настройки  -->
        <Style Selector="StackPanel.setting-description">
            <Setter Property="Spacing" Value="4" />
        </Style>

        <!--  Общий стиль названия настройки  -->
        <Style Selector="TextBlock.setting-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  Общий стиль пояснения настройки  -->
        <Style Selector="TextBlock.setting-hint">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="28,24,28,32">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="28">

                <!--  Заголовок страницы  -->
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Settings" />
                    <TextBlock Opacity="0.6" Text="Customize your Libris experience." />
                </StackPanel>

                <!--  Внешний вид  -->
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Appearance" />

                    <suki:GlassCard Padding="24" IsAnimated="True">
                        <StackPanel Spacing="20">

                            <!--  Тема  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Theme" />
                                    <TextBlock Classes="setting-hint" Text="Choose how Libris should look." />
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="180"
                                    ItemsSource="{Binding AvailableThemes}"
                                    SelectedItem="{Binding Theme}" />
                            </Grid>

                            <!--  Акцентный цвет  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Accent Color" />
                                    <TextBlock Classes="setting-hint" Text="Choose the application's accent color." />
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="180"
                                    ItemsSource="{Binding AvailableAccentColors}"
                                    SelectedItem="{Binding AccentColor}" />
                            </Grid>

                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>

                <!--  Чтение  -->
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Reading" />

                    <suki:GlassCard Padding="24" IsAnimated="True">
                        <StackPanel Spacing="20">

                            <!--  Шрифт  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Default Font" />
                                    <TextBlock Classes="setting-hint" Text="Font used when opening a book." />
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="180"
                                    ItemsSource="{Binding AvailableFonts}"
                                    SelectedItem="{Binding DefaultFont}" />
                            </Grid>

                            <!--  Размер шрифта  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Font Size" />
                                    <TextBlock Classes="setting-hint" Text="Default reading text size." />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    Increment="1"
                                    Maximum="40"
                                    Minimum="10"
                                    Value="{Binding FontSize}" />
                            </Grid>

                            <!--  Межстрочный интервал  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Line Spacing" />
                                    <TextBlock Classes="setting-hint" Text="Space between lines of text." />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    Increment="0.1"
                                    Maximum="3"
                                    Minimum="1"
                                    Value="{Binding LineSpacing}" />
                            </Grid>

                            <!--  Ширина области чтения  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Reading Width" />
                                    <TextBlock Classes="setting-hint" Text="Maximum width of the reading area." />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    Increment="20"
                                    Maximum="1200"
                                    Minimum="400"
                                    Value="{Binding ReadingWidth}" />
                            </Grid>

                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>

                <!--  Библиотека  -->
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Library" />

                    <suki:GlassCard Padding="24" IsAnimated="True">
                        <StackPanel Spacing="20">

                            <!--  Сортировка  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Default Sorting" />
                                    <TextBlock Classes="setting-hint" Text="How books are sorted by default." />
                                </StackPanel>

                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="180"
                                    ItemsSource="{Binding AvailableSortingOptions}"
                                    SelectedItem="{Binding DefaultSorting}" />
                            </Grid>

                            <!--  Прогресс чтения  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Show Progress" />
                                    <TextBlock Classes="setting-hint" Text="Display reading progress in the library." />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding ShowProgress}" />
                            </Grid>

                            <!--  Размер обложки  -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                                <StackPanel Classes="setting-description">
                                    <TextBlock Classes="setting-title" Text="Cover Size" />
                                    <TextBlock Classes="setting-hint" Text="Default size of book covers." />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="180"
                                    Increment="10"
                                    Maximum="300"
                                    Minimum="80"
                                    Value="{Binding CoverSize}" />
                            </Grid>

                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
