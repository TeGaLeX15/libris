<!--  Views/LibraryView.axaml  -->
<!--  Views/LibraryView.axaml  -->

<UserControl
    x:Class="Libris.Views.LibraryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Libris.Controls"
    xmlns:converters="using:Libris.Converters"
    xmlns:models="using:Libris.Models"
    xmlns:vm="using:Libris.ViewModels"
    x:DataType="vm:LibraryViewModel">

    <UserControl.Resources>
        <converters:BookCoverConverter x:Key="BookCoverConverter" />
    </UserControl.Resources>

    <Grid>

        <!--  Прокручиваемая область страницы  -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

            <Grid Margin="28,24,28,32" RowDefinitions="Auto,*">

                <!--  Заголовок страницы  -->
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,28"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="12">

                    <!--  Название и описание  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="5">

                        <TextBlock
                            FontSize="32"
                            FontWeight="SemiBold"
                            Text="Library" />

                        <TextBlock
                            FontSize="14"
                            Opacity="0.6"
                            Text="Your books in one place." />

                    </StackPanel>

                    <!--  Поиск  -->
                    <Border
                        Grid.Column="1"
                        MinWidth="220"
                        MaxWidth="460"
                        Padding="14,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="#0DFFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10">

                        <TextBox
                            Padding="4,6"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            PlaceholderText="Search your library..."
                            Text="{Binding SearchQuery, Mode=TwoWay}" />

                    </Border>

                    <!--  Сортировка  -->
                    <ComboBox
                        Grid.Column="2"
                        Width="145"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSort, Mode=TwoWay}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                    <!--  Добавление книг  -->
                    <Button
                        Grid.Column="3"
                        Padding="20,10"
                        VerticalAlignment="Center"
                        Click="AddBooks_Click"
                        Content="Add books" />

                </Grid>

                <!--  Основное содержимое  -->
                <Grid Grid.Row="1">

                    <!--  Пустая библиотека  -->
                    <StackPanel
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsEmpty}"
                        Spacing="10">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="Your library is empty" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Text="Add your first books to start reading."
                            TextAlignment="Center" />

                        <Button
                            Margin="0,14,0,0"
                            Padding="24,12"
                            HorizontalAlignment="Center"
                            Click="AddBooks_Click"
                            Content="Add books" />

                    </StackPanel>

                    <!--  Нет результатов поиска  -->
                    <StackPanel
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsSearchEmpty}"
                        Spacing="10">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="No books found" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Text="Try a different title or author."
                            TextAlignment="Center" />

                    </StackPanel>

                    <!--  Сетка книг  -->
                    <ItemsControl
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding !IsEmpty}"
                        ItemsSource="{Binding FilteredBooks}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>

                                <controls:ResponsiveWrapPanel
                                    HorizontalSpacing="18"
                                    ItemHeight="326"
                                    ItemWidth="184"
                                    VerticalSpacing="22" />

                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Book">

                                <controls:BookCard
                                    Width="184"
                                    Height="326"
                                    OpenBookRequested="BookCard_OpenBookRequested" />

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>
